// playground の firestore.rules に、「ここから/ここまで」の間を「match /databases/{database}/documents { ... }」の中へ足す(他のアプリの match の後ろでよい。すでにあるなら、目印の間だけ置き換える)
// 運営: 下の looIsAdmin() の 'CHANGE_ME_ADMIN_EMAIL' を、admin.html に Google ログインするメールアドレスに書き換えてから公開する(書き換えるまでは、誰も運営になれないので安全)
    // ===== 札幌トイレマップ(loo-) ここから =====
    function looIsAdmin() {
      return request.auth != null
        && request.auth.token.email == 'CHANGE_ME_ADMIN_EMAIL'
        && request.auth.token.email_verified == true;
    }
    // トイレ・コンビニの項目の検査(申請 loo-requests と、運営が許可して書く loo-toilets の両方で使う)
    function looToiletOk(d) {
      return d.keys().hasOnly(['name','lat','lng','fee','wheelchair','floor','stalls','ease','find','type','brand','loan','note','uid','createdAt','approved'])
        && d.keys().hasAll(['name','lat','lng','fee','wheelchair','floor','ease','find','type','brand','loan','note','uid','createdAt'])
        && (d.ease == null || (d.ease is int && d.ease >= 1 && d.ease <= 5))
        && (d.find == null || (d.find is int && d.find >= 1 && d.find <= 5))
        && d.type in ['toilet','conv']
        && (d.brand == null || d.brand in ['seven','family','lawson','seico','other'])
        && (d.loan == null || d.loan in ['yes','ask','no'])
        && d.name is string && d.name.size() <= 40
        && d.note is string && d.note.size() <= 200
        && d.lat is number && d.lat > 43.03 && d.lat < 43.09
        && d.lng is number && d.lng > 141.32 && d.lng < 141.38
        && (d.fee == null || d.fee is bool)
        && (d.wheelchair == null || d.wheelchair is bool)
        && (d.floor == null || (d.floor is int && d.floor >= -3 && d.floor <= 30))
        && (!('stalls' in d) || d.stalls == null || (d.stalls is int && d.stalls >= 1 && d.stalls <= 20))
        && d.uid is string;
    }

    // 公開中のトイレ。読むのは誰でも。書けるのは運営だけ(申請を許可するとき loo-requests から移す。許可した印 approved: true)
    // 運営の許可制にする前の投稿(approved なし)は、そのまま残る。削除は作った本人と運営
    match /loo-toilets/{id} {
      allow read: if true;
      allow create: if looIsAdmin()
        && id.matches('[A-Za-z0-9]{20}')
        && looToiletOk(request.resource.data)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.approved == true;
      allow update: if looIsAdmin()
        && looToiletOk(request.resource.data)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || looIsAdmin());
    }

    // 申請(許可待ちのトイレ・コンビニ)。作れるのは匿名ログイン済みの誰でも(投稿の間隔は loo-users が見張る)
    // 読めるのは申請した本人と運営だけ。許可・却下・編集は運営、取り消しは本人
    match /loo-requests/{id} {
      allow get, list: if request.auth != null && (resource.data.uid == request.auth.uid || looIsAdmin());
      allow create: if request.auth != null
        && id.matches('[A-Za-z0-9]{20}')
        && getAfter(/databases/$(database)/documents/loo-users/$(request.auth.uid)).data.lastId == id
        && getAfter(/databases/$(database)/documents/loo-users/$(request.auth.uid)).data.lastAt == request.time
        && looToiletOk(request.resource.data)
        && !('approved' in request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if looIsAdmin() && looToiletOk(request.resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || looIsAdmin());
    }

    // 「使えなかった」などの一言報告。1人1トイレ1件(ID = トイレID_ユーザーID)。上書き・取り消しは本人だけ
    match /loo-reports/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['toiletId','kind','uid','createdAt'])
        && request.resource.data.keys().hasAll(['toiletId','kind','uid','createdAt'])
        && request.resource.data.toiletId is string && request.resource.data.toiletId.size() <= 60
        && request.resource.data.kind in ['clean','crowded','closed','loan-yes','loan-ask','loan-no','missing','lv-gr','lv-ug','lv-up','stall-1','stall-2','stall-3','stall-4','stall-5']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && ((!request.resource.data.kind.matches('lv-.*') && !request.resource.data.kind.matches('stall-.*') && id == request.resource.data.toiletId + '_' + request.auth.uid)
            || (request.resource.data.kind.matches('lv-.*') && id == request.resource.data.toiletId + '_lv_' + request.auth.uid)
            || (request.resource.data.kind.matches('stall-.*') && id == request.resource.data.toiletId + '_stall_' + request.auth.uid));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // 投稿(申請)の間隔と回数(1人あたり 30 秒に1件・24時間に10件)。申請するとき、同じバッチでここも更新する(lastId = 申請の ID)
    match /loo-users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt','n','windowStart','lastId'])
        && request.resource.data.keys().hasAll(['lastAt','n','windowStart','lastId'])
        && request.resource.data.lastId is string
        && request.resource.data.lastAt == request.time
        && request.resource.data.windowStart == request.time
        && request.resource.data.n == 1;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt','n','windowStart','lastId'])
        && request.resource.data.keys().hasAll(['lastAt','n','windowStart','lastId'])
        && request.resource.data.lastId is string
        && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(30, 's')
        && (
          (request.time < resource.data.windowStart + duration.value(24, 'h')
            && request.resource.data.windowStart == resource.data.windowStart
            && request.resource.data.n == resource.data.n + 1
            && request.resource.data.n <= 10)
          || (request.time >= resource.data.windowStart + duration.value(24, 'h')
            && request.resource.data.windowStart == request.time
            && request.resource.data.n == 1));
    }
    // ===== 札幌トイレマップ(loo-) ここまで =====
