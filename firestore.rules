rules_version = '2';

// 札幌トイレマップ: ユーザーが追加したトイレ(loo-toilets)と一言報告(loo-reports)だけを扱う。
// 他のアプリと同じ Firebase プロジェクト(playground)で使うため、コレクション名は loo- で始める。
// - 読むのは誰でも。追加は匿名ログイン済みなら誰でも(項目・長さ・札幌周辺の座標に制限)
// - 書き換えは禁止。削除は追加した本人だけ
// - loo-reports(一言報告)は 1人1トイレ1件。読むのは誰でも、書く・消すのは本人だけ
service cloud.firestore {
  match /databases/{database}/documents {
    match /loo-toilets/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && id.matches('[A-Za-z0-9]{20}')
        && getAfter(/databases/$(database)/documents/loo-users/$(request.auth.uid)).data.lastId == id
        && getAfter(/databases/$(database)/documents/loo-users/$(request.auth.uid)).data.lastAt == request.time
        && request.resource.data.keys().hasOnly(['name','lat','lng','fee','wheelchair','floor','ease','find','type','brand','loan','note','uid','createdAt'])
        && request.resource.data.keys().hasAll(['name','lat','lng','fee','wheelchair','floor','ease','find','type','brand','loan','note','uid','createdAt'])
        && (request.resource.data.ease == null || (request.resource.data.ease is int && request.resource.data.ease >= 1 && request.resource.data.ease <= 5))
        && (request.resource.data.find == null || (request.resource.data.find is int && request.resource.data.find >= 1 && request.resource.data.find <= 5))
        && request.resource.data.type in ['toilet','conv']
        && (request.resource.data.brand == null || request.resource.data.brand in ['seven','family','lawson','seico','other'])
        && (request.resource.data.loan == null || request.resource.data.loan in ['yes','ask','no'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.lat is number && request.resource.data.lat > 43.03 && request.resource.data.lat < 43.09
        && request.resource.data.lng is number && request.resource.data.lng > 141.32 && request.resource.data.lng < 141.38
        && (request.resource.data.fee == null || request.resource.data.fee is bool)
        && (request.resource.data.wheelchair == null || request.resource.data.wheelchair is bool)
        && (request.resource.data.floor == null || (request.resource.data.floor is int && request.resource.data.floor >= -3 && request.resource.data.floor <= 30))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 「きれい/混んでた/使えなかった」の一言。1人1トイレ1件(ID = トイレID_ユーザーID)。上書き・取り消しは本人だけ
    match /loo-reports/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['toiletId','kind','uid','createdAt'])
        && request.resource.data.keys().hasAll(['toiletId','kind','uid','createdAt'])
        && request.resource.data.toiletId is string && request.resource.data.toiletId.size() <= 60
        && request.resource.data.kind in ['clean','crowded','closed','loan-yes','loan-ask','loan-no','missing','lv-gr','lv-ug','lv-up']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && ((!request.resource.data.kind.matches('lv-.*') && id == request.resource.data.toiletId + '_' + request.auth.uid)
            || (request.resource.data.kind.matches('lv-.*') && id == request.resource.data.toiletId + '_lv_' + request.auth.uid));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 投稿の間隔と回数(1人あたり 30 秒に1件・24時間に10件)。トイレを追加するとき、同じバッチでここも更新する(lastId = 追加するトイレの ID)
    match /loo-users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt','n','windowStart','lastId'])
        && request.resource.data.keys().hasAll(['lastAt','n','windowStart','lastId'])
        && request.resource.data.lastId is string
        && request.resource.data.lastAt == request.time
        && request.resource.data.windowStart == request.time
        && request.resource.data.n == 1;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt','n','windowStart','lastId'])
        && request.resource.data.keys().hasAll(['lastAt','n','windowStart','lastId'])
        && request.resource.data.lastId is string
        && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(30, 's')
        && (
          (request.time < resource.data.windowStart + duration.value(24, 'h')
            && request.resource.data.windowStart == resource.data.windowStart
            && request.resource.data.n == resource.data.n + 1
            && request.resource.data.n <= 10)
          || (request.time >= resource.data.windowStart + duration.value(24, 'h')
            && request.resource.data.windowStart == request.time
            && request.resource.data.n == 1));
    }
  }
}
